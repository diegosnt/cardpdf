---
import Layout from '../layouts/Layout.astro';
import CardPanel from '../components/CardPanel.astro';
import { CARD_CONFIG } from '../utils/constants';
---

<Layout>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Panel Izquierdo: Carga, Edición y Opciones (6 cols) -->
    <div class="lg:col-span-6 space-y-6">
      
      <!-- Encabezado de la aplicación -->
      <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-sky-500/20 text-sky-400 uppercase tracking-wider border border-sky-500/30">
            Estándar Internacional
          </span>
          <span class="text-xs text-slate-300 font-mono font-semibold">ISO/IEC 7810 ID-1 (CR80)</span>
          <span class="text-[11px] text-slate-400 font-mono">• Proporción 1.586</span>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold text-white tracking-tight">
            Fotocopia de Tarjetas y Documentos en Tamaño Real (A4)
          </h1>
          <p class="text-sm text-slate-300 mt-1 leading-relaxed">
            Sube las fotos del frente y dorso de cualquier documento o tarjeta bajo la norma ID-1 / CR80 
            (<span class="font-mono text-sky-300">{CARD_CONFIG.WIDTH_MM} × {CARD_CONFIG.HEIGHT_MM} mm</span>). 
            La aplicación las recorta con esquinas redondeadas (<span class="font-mono text-sky-300">{CARD_CONFIG.CORNER_RADIUS_MM} mm</span>) 
            y las posiciona matemáticamente a escala 100% sobre una hoja A4 lista para imprimir.
          </p>
        </div>

        <!-- Badges de compatibilidad universal -->
        <div class="flex flex-wrap gap-1.5 pt-1 text-[11px] text-slate-300">
          <span class="px-2 py-0.5 rounded-md bg-slate-800/80 border border-slate-700/60 flex items-center gap-1">🪪 DNI / Identidad</span>
          <span class="px-2 py-0.5 rounded-md bg-slate-800/80 border border-slate-700/60 flex items-center gap-1">🚗 Licencia de Conducir</span>
          <span class="px-2 py-0.5 rounded-md bg-slate-800/80 border border-slate-700/60 flex items-center gap-1">🚙 Cédula Verde / Azul</span>
          <span class="px-2 py-0.5 rounded-md bg-slate-800/80 border border-slate-700/60 flex items-center gap-1">🏢 Credencial Corporativa</span>
          <span class="px-2 py-0.5 rounded-md bg-slate-800/80 border border-slate-700/60 flex items-center gap-1">🏥 Carnet de Salud / Obra Social</span>
          <span class="px-2 py-0.5 rounded-md bg-slate-800/80 border border-slate-700/60 flex items-center gap-1">💳 Tarjeta de Transporte</span>
        </div>
      </div>

      <!-- Zonas de Carga: Frente y Dorso -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <CardPanel
          side="front"
          stepNumber={1}
          title="Frente de la Tarjeta"
          accentColor="sky"
        />
        <CardPanel
          side="back"
          stepNumber={2}
          title="Dorso de la Tarjeta"
          accentColor="indigo"
        />
      </div>

      <!-- Configuración de Estilo y Opciones de Impresión -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 space-y-4 shadow-sm">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
            <span>Estilo de la Fotocopia</span>
          </h3>
          <span class="text-[11px] text-slate-400">Salida para impresión</span>
        </div>

        <!-- Selector de Estilo de Fotocopia -->
        <div class="grid grid-cols-3 gap-2" id="color-mode-selector">
          <button 
            type="button" 
            data-mode="original" 
            class="color-mode-btn active px-3 py-2.5 rounded-xl border text-left flex flex-col gap-1 transition-all bg-sky-500/15 border-sky-500 text-white cursor-pointer"
          >
            <span class="text-xs font-bold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-sky-400 shadow-sm shadow-sky-400/50"></span> Color Real
            </span>
            <span class="text-[10px] text-slate-400">Foto original</span>
          </button>

          <button 
            type="button" 
            data-mode="grayscale" 
            class="color-mode-btn px-3 py-2.5 rounded-xl border border-slate-800 hover:border-slate-700 text-left flex flex-col gap-1 transition-all text-slate-300 cursor-pointer"
          >
            <span class="text-xs font-bold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-slate-400"></span> Grises
            </span>
            <span class="text-[10px] text-slate-400">Monocromático</span>
          </button>

          <button 
            type="button" 
            data-mode="photocopy" 
            class="color-mode-btn px-3 py-2.5 rounded-xl border border-slate-800 hover:border-slate-700 text-left flex flex-col gap-1 transition-all text-slate-300 cursor-pointer"
          >
            <span class="text-xs font-bold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-white shadow-sm"></span> Tóner B&N
            </span>
            <span class="text-[10px] text-slate-400">Alto contraste</span>
          </button>
        </div>

        <!-- Selector de Disposición en la Hoja A4 -->
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
            <span>📐 Disposición en la Hoja A4</span>
          </label>
          <div class="grid grid-cols-2 gap-2">
            <button 
              type="button" 
              data-layout="vertical" 
              class="layout-mode-btn px-3 py-2.5 rounded-xl border bg-sky-500/15 border-sky-500 text-white text-left flex flex-col gap-0.5 transition-all cursor-pointer"
            >
              <span class="text-xs font-bold flex items-center gap-1.5">
                <span>⬇️ Una debajo de otra</span>
              </span>
              <span class="text-[10px] text-slate-400">Apiladas verticalmente</span>
            </button>

            <button 
              type="button" 
              data-layout="horizontal" 
              class="layout-mode-btn px-3 py-2.5 rounded-xl border border-slate-800 hover:border-slate-700 text-left flex flex-col gap-0.5 transition-all text-slate-300 cursor-pointer"
            >
              <span class="text-xs font-bold flex items-center gap-1.5">
                <span>➡️ Una al lado de otra</span>
              </span>
              <span class="text-[10px] text-slate-400">En paralelo horizontal</span>
            </button>
          </div>
        </div>

        <!-- Opción Vertical: Imprimir 2 juegos iguales en la misma hoja -->
        <div id="container-vertical-duplicate">
          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800 hover:border-slate-700 cursor-pointer transition-all select-none group">
            <input 
              type="checkbox" 
              id="checkbox-duplicate-set" 
              class="w-4 h-4 rounded border-slate-700 text-sky-500 focus:ring-sky-500 focus:ring-offset-slate-900 bg-slate-800 cursor-pointer accent-sky-500"
            />
            <div class="flex-1">
              <span class="text-xs font-bold text-slate-200 group-hover:text-white flex items-center gap-1.5">
                <span>🖨️ Imprimir 2 juegos iguales</span>
                <span class="text-[10px] font-normal px-1.5 py-0.2 rounded bg-sky-500/10 text-sky-400 border border-sky-500/20">2 copias</span>
              </span>
              <span class="text-[11px] text-slate-400 block mt-0.5">Duplica frente y dorso en la mitad inferior de la misma hoja A4</span>
            </div>
          </label>
        </div>

        <!-- Opción Horizontal: Cantidad de Filas de Imágenes (1, 2, 3 o 4 filas) -->
        <div id="container-horizontal-rows" class="hidden space-y-2 p-3 rounded-xl bg-slate-900/60 border border-slate-800">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-200 flex items-center gap-1.5">
              <span>📑 Filas en la hoja A4:</span>
            </span>
            <span id="horiz-rows-badge" class="text-[10px] font-semibold px-2 py-0.5 rounded bg-sky-500/10 text-sky-400 border border-sky-500/20">
              1 juego (2 fotos)
            </span>
          </div>
          <div class="grid grid-cols-4 gap-1.5 pt-0.5">
            <button
              type="button"
              data-rows="1"
              class="horiz-rows-btn py-1.5 px-2 rounded-lg text-xs font-bold transition-all cursor-pointer bg-sky-500 text-white shadow-xs"
            >
              1 fila
            </button>
            <button
              type="button"
              data-rows="2"
              class="horiz-rows-btn py-1.5 px-2 rounded-lg text-xs font-medium transition-all cursor-pointer bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 border border-slate-700/50"
            >
              2 filas
            </button>
            <button
              type="button"
              data-rows="3"
              class="horiz-rows-btn py-1.5 px-2 rounded-lg text-xs font-medium transition-all cursor-pointer bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 border border-slate-700/50"
            >
              3 filas
            </button>
            <button
              type="button"
              data-rows="4"
              class="horiz-rows-btn py-1.5 px-2 rounded-lg text-xs font-medium transition-all cursor-pointer bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 border border-slate-700/50"
            >
              4 filas
            </button>
          </div>
          <span class="text-[11px] text-slate-400 block">Elige entre 1 y 4 filas paralelas completas en la hoja A4</span>
        </div>

        <!-- Botones de Acción -->
        <div class="space-y-2">
          <!-- Botón de Descarga Principal -->
          <button 
            type="button" 
            id="btn-download-pdf" 
            disabled
            class="w-full py-3.5 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 shadow-lg transition-all duration-200 bg-gradient-to-r from-sky-500 via-blue-600 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white shadow-sky-500/25 disabled:opacity-40 disabled:cursor-not-allowed disabled:shadow-none cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span id="btn-download-text">Descargar Fotocopia PDF (A4 - 100%)</span>
          </button>

          <!-- Botón de Reinicio para generar otro PDF -->
          <button 
            type="button" 
            id="btn-reset-all" 
            disabled
            class="w-full py-2.5 px-4 rounded-xl font-medium text-xs flex items-center justify-center gap-2 transition-all duration-200 text-slate-300 hover:text-white bg-slate-900/80 hover:bg-slate-800 border border-slate-700/60 hover:border-slate-600 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
          >
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Reiniciar para generar otro PDF</span>
          </button>
        </div>

      </div>

      <!-- Ficha técnica informativa de las medidas -->
      <div class="bg-slate-900/40 border border-slate-800/60 rounded-xl p-4 text-xs text-slate-400 space-y-2">
        <div class="font-bold text-slate-300 text-[11px] uppercase tracking-wider flex items-center gap-1.5">
          <span>📐 Parámetros de Precisión Geométrica</span>
        </div>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-[11px]">
          <div>• Norma: <span class="text-slate-200 font-mono">ISO/IEC 7810 ID-1 (CR80)</span></div>
          <div>• Tamaño: <span class="text-slate-200 font-mono">85.60 × 53.98 mm</span></div>
          <div>• Proporción: <span class="text-slate-200 font-mono">1.586 (Estándar)</span></div>
          <div>• Radio curvatura: <span class="text-slate-200 font-mono">3.18 mm</span></div>
          <div>• Hoja de salida: <span class="text-slate-200 font-mono">A4 (210 × 297 mm)</span></div>
          <div>• Centrado horizontal: <span class="text-slate-200 font-mono">X = 62.20 mm</span></div>
          <div>• Posición Frente: <span class="text-slate-200 font-mono">Y = 20.00 mm (Superior)</span></div>
          <div>• Posición Dorso: <span class="text-slate-200 font-mono">Y = 86.00 mm</span></div>
          <div>• Separación entre fotos: <span class="text-slate-200 font-mono">12.02 mm</span></div>
          <div>• Separación entre juegos: <span class="text-slate-200 font-mono">17.04 mm (Doble juego)</span></div>
          <div>• Resolución: <span class="text-slate-200 font-mono">300 DPI (100% escala)</span></div>
        </div>
      </div>

    </div>

    <!-- Panel Derecho: Vista Previa Hoja A4 Interactiva (6 cols) -->
    <div class="lg:col-span-6 sticky top-20">
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <h2 class="font-bold text-sm text-slate-200">Vista Previa Hoja A4</h2>
          </div>
          <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">
            Escala 100% Real
          </span>
        </div>

        <!-- Contenedor de la Hoja A4 -->
        <div class="relative w-full max-w-[430px] mx-auto bg-slate-950 p-4 sm:p-6 rounded-xl border border-slate-800/80 flex items-center justify-center">
          
          <!-- Hoja A4 simulada (relación de aspecto 210/297) -->
          <div 
            id="a4-sheet"
            class="relative w-full aspect-[210/297] bg-white rounded-[2px] shadow-2xl overflow-hidden select-none border border-slate-300 transition-all duration-300"
          >
            <!-- Cuadrícula milimétrica sutil -->
            <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:16px_16px] opacity-40 pointer-events-none"></div>

            <!-- Rótulo A4 -->
            <div class="absolute top-2.5 left-3 text-[8px] font-mono text-slate-400 font-medium select-none">
              A4 • 210 × 297 mm
            </div>

            <!-- TARJETA FRENTE en la hoja (Elevada Y = 20.00 mm -> 6.734%) -->
            <div 
              id="sheet-card-front"
              class="absolute rounded-[4px] sm:rounded-[6px] overflow-hidden border border-dashed border-slate-300 transition-all flex items-center justify-center bg-slate-50"
              style="left: 29.619%; top: 6.734%; width: 40.762%; height: 18.175%;"
            >
              <canvas id="canvas-preview-front" class="w-full h-full object-cover hidden cursor-grab active:cursor-grabbing"></canvas>
              
              <div id="placeholder-preview-front" class="text-center p-1">
                <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 block">FRENTE</span>
                <span class="text-[7px] text-slate-300 font-mono block">85.60 × 53.98 mm</span>
              </div>
            </div>

            <!-- TARJETA DORSO en la hoja (Elevada Y = 86.00 mm -> 28.956%) -->
            <div 
              id="sheet-card-back"
              class="absolute rounded-[4px] sm:rounded-[6px] overflow-hidden border border-dashed border-slate-300 transition-all flex items-center justify-center bg-slate-50"
              style="left: 29.619%; top: 28.956%; width: 40.762%; height: 18.175%;"
            >
              <canvas id="canvas-preview-back" class="w-full h-full object-cover hidden cursor-grab active:cursor-grabbing"></canvas>
              
              <div id="placeholder-preview-back" class="text-center p-1">
                <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 block">DORSO</span>
                <span class="text-[7px] text-slate-300 font-mono block">85.60 × 53.98 mm</span>
              </div>
            </div>




            <!-- JUEGO 2 (Copia 2 / Fila 2 en horizontal) -->
            <div id="sheet-set2-container" class="hidden">
              <!-- TARJETA FRENTE 2 en la hoja -->
              <div 
                id="sheet-card-front-2"
                class="absolute rounded-[4px] sm:rounded-[6px] overflow-hidden border border-dashed border-slate-300 transition-all flex items-center justify-center bg-slate-50"
                style="left: 29.619%; top: 52.869%; width: 40.762%; height: 18.175%;"
              >
                <canvas id="canvas-preview-front-2" class="w-full h-full object-cover hidden"></canvas>
                
                <div id="placeholder-preview-front-2" class="text-center p-1">
                  <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 block">FRENTE</span>
                  <span class="text-[7px] text-slate-300 font-mono block">Copia 2</span>
                </div>
              </div>

              <!-- TARJETA DORSO 2 en la hoja -->
              <div 
                id="sheet-card-back-2"
                class="absolute rounded-[4px] sm:rounded-[6px] overflow-hidden border border-dashed border-slate-300 transition-all flex items-center justify-center bg-slate-50"
                style="left: 29.619%; top: 75.091%; width: 40.762%; height: 18.175%;"
              >
                <canvas id="canvas-preview-back-2" class="w-full h-full object-cover hidden"></canvas>
                
                <div id="placeholder-preview-back-2" class="text-center p-1">
                  <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 block">DORSO</span>
                  <span class="text-[7px] text-slate-300 font-mono block">Copia 2</span>
                </div>
              </div>

            </div>

            <!-- JUEGO 3 (Fila 3 en horizontal) -->
            <div id="sheet-row3-container" class="hidden">
              <!-- TARJETA FRENTE 3 -->
              <div 
                id="sheet-card-front-3"
                class="absolute rounded-[4px] sm:rounded-[6px] overflow-hidden border border-dashed border-slate-300 transition-all flex items-center justify-center bg-slate-50"
                style="left: 7.619%; top: 52.754%; width: 40.762%; height: 18.175%;"
              >
                <canvas id="canvas-preview-front-3" class="w-full h-full object-cover hidden"></canvas>
                <div id="placeholder-preview-front-3" class="text-center p-1">
                  <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 block">FRENTE</span>
                  <span class="text-[7px] text-slate-300 font-mono block">Copia 3</span>
                </div>
              </div>

              <!-- TARJETA DORSO 3 -->
              <div 
                id="sheet-card-back-3"
                class="absolute rounded-[4px] sm:rounded-[6px] overflow-hidden border border-dashed border-slate-300 transition-all flex items-center justify-center bg-slate-50"
                style="left: 51.619%; top: 52.754%; width: 40.762%; height: 18.175%;"
              >
                <canvas id="canvas-preview-back-3" class="w-full h-full object-cover hidden"></canvas>
                <div id="placeholder-preview-back-3" class="text-center p-1">
                  <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 block">DORSO</span>
                  <span class="text-[7px] text-slate-300 font-mono block">Copia 3</span>
                </div>
              </div>
            </div>

            <!-- JUEGO 4 (Fila 4 en horizontal) -->
            <div id="sheet-row4-container" class="hidden">
              <!-- TARJETA FRENTE 4 -->
              <div 
                id="sheet-card-front-4"
                class="absolute rounded-[4px] sm:rounded-[6px] overflow-hidden border border-dashed border-slate-300 transition-all flex items-center justify-center bg-slate-50"
                style="left: 7.619%; top: 76.438%; width: 40.762%; height: 18.175%;"
              >
                <canvas id="canvas-preview-front-4" class="w-full h-full object-cover hidden"></canvas>
                <div id="placeholder-preview-front-4" class="text-center p-1">
                  <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 block">FRENTE</span>
                  <span class="text-[7px] text-slate-300 font-mono block">Copia 4</span>
                </div>
              </div>

              <!-- TARJETA DORSO 4 -->
              <div 
                id="sheet-card-back-4"
                class="absolute rounded-[4px] sm:rounded-[6px] overflow-hidden border border-dashed border-slate-300 transition-all flex items-center justify-center bg-slate-50"
                style="left: 51.619%; top: 76.438%; width: 40.762%; height: 18.175%;"
              >
                <canvas id="canvas-preview-back-4" class="w-full h-full object-cover hidden"></canvas>
                <div id="placeholder-preview-back-4" class="text-center p-1">
                  <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 block">DORSO</span>
                  <span class="text-[7px] text-slate-300 font-mono block">Copia 4</span>
                </div>
              </div>
            </div>

          </div>

        </div>

        <div class="flex items-center justify-between text-[11px] text-slate-400 px-1">
          <span>📏 Tamaño real 1:1 al imprimir sin escalar</span>
          <span class="text-slate-300 font-mono">DPI: 300</span>
        </div>

      </div>
    </div>

  </div>
</Layout>

<script>
  import { loadFileAsImage, renderCardToCanvas, clampCardOffsets, validateImageFile, type CardState } from '../utils/imageProcessor';
  import { generateAndDownloadPdf } from '../utils/pdfGenerator';
  import { CARD_CONFIG, type ColorMode, type LayoutMode, type HorizontalRowCount } from '../utils/constants';

  type CardSide = 'front' | 'back';

  interface SideConfig {
    accentColor: 'sky' | 'indigo';
    dragActiveClasses: string[];
    badgeActiveClass: string;
  }

  const SIDE_CONFIG: Record<CardSide, SideConfig> = {
    front: {
      accentColor: 'sky',
      dragActiveClasses: ['border-sky-400', 'bg-sky-500/10'],
      badgeActiveClass: 'bg-sky-500/20 text-sky-400 border-sky-500/30',
    },
    back: {
      accentColor: 'indigo',
      dragActiveClasses: ['border-indigo-400', 'bg-indigo-500/10'],
      badgeActiveClass: 'bg-indigo-500/20 text-indigo-400 border-indigo-500/30',
    },
  };

  interface SideElements {
    dropzone: HTMLElement;
    fileInput: HTMLInputElement;
    emptyState: HTMLElement;
    previewContainer: HTMLElement;
    miniCanvas: HTMLCanvasElement;
    controls: HTMLElement;
    btnRotate: HTMLButtonElement;
    btnReset: HTMLButtonElement;
    btnRemove: HTMLButtonElement;
    btnZoomOut: HTMLButtonElement;
    btnZoomIn: HTMLButtonElement;
    zoomVal: HTMLElement;
    badge: HTMLElement;
    canvasPreview: HTMLCanvasElement;
    placeholderPreview: HTMLElement;
    sheetCard: HTMLElement;
    canvasPreview2: HTMLCanvasElement | null;
    placeholderPreview2: HTMLElement | null;
    sheetCard2: HTMLElement | null;
    canvasPreview3: HTMLCanvasElement | null;
    placeholderPreview3: HTMLElement | null;
    sheetCard3: HTMLElement | null;
    canvasPreview4: HTMLCanvasElement | null;
    placeholderPreview4: HTMLElement | null;
    sheetCard4: HTMLElement | null;
  }

  function getSideElements(side: CardSide): SideElements {
    return {
      dropzone: document.getElementById(`dropzone-${side}`) as HTMLElement,
      fileInput: document.getElementById(`file-${side}`) as HTMLInputElement,
      emptyState: document.getElementById(`empty-state-${side}`) as HTMLElement,
      previewContainer: document.getElementById(`preview-container-${side}`) as HTMLElement,
      miniCanvas: document.getElementById(`mini-canvas-${side}`) as HTMLCanvasElement,
      controls: document.getElementById(`controls-${side}`) as HTMLElement,
      btnRotate: document.getElementById(`btn-rotate-${side}`) as HTMLButtonElement,
      btnReset: document.getElementById(`btn-reset-${side}`) as HTMLButtonElement,
      btnRemove: document.getElementById(`btn-remove-${side}`) as HTMLButtonElement,
      btnZoomOut: document.getElementById(`btn-zoom-out-${side}`) as HTMLButtonElement,
      btnZoomIn: document.getElementById(`btn-zoom-in-${side}`) as HTMLButtonElement,
      zoomVal: document.getElementById(`zoom-val-${side}`) as HTMLElement,
      badge: document.getElementById(`badge-${side}`) as HTMLElement,
      canvasPreview: document.getElementById(`canvas-preview-${side}`) as HTMLCanvasElement,
      placeholderPreview: document.getElementById(`placeholder-preview-${side}`) as HTMLElement,
      sheetCard: document.getElementById(`sheet-card-${side}`) as HTMLElement,
      canvasPreview2: document.getElementById(`canvas-preview-${side}-2`) as HTMLCanvasElement | null,
      placeholderPreview2: document.getElementById(`placeholder-preview-${side}-2`) as HTMLElement | null,
      sheetCard2: document.getElementById(`sheet-card-${side}-2`) as HTMLElement | null,
      canvasPreview3: document.getElementById(`canvas-preview-${side}-3`) as HTMLCanvasElement | null,
      placeholderPreview3: document.getElementById(`placeholder-preview-${side}-3`) as HTMLElement | null,
      sheetCard3: document.getElementById(`sheet-card-${side}-3`) as HTMLElement | null,
      canvasPreview4: document.getElementById(`canvas-preview-${side}-4`) as HTMLCanvasElement | null,
      placeholderPreview4: document.getElementById(`placeholder-preview-${side}-4`) as HTMLElement | null,
      sheetCard4: document.getElementById(`sheet-card-${side}-4`) as HTMLElement | null,
    };
  }

  // Estados de las tarjetas
  const cards: Record<CardSide, CardState> = {
    front: { file: null, imageElement: null, rotation: 0, zoom: 1.0, offsetX: 0, offsetY: 0 },
    back: { file: null, imageElement: null, rotation: 0, zoom: 1.0, offsetX: 0, offsetY: 0 },
  };

  // Elementos del DOM agrupados por cara
  const elements: Record<CardSide, SideElements> = {
    front: getSideElements('front'),
    back: getSideElements('back'),
  };

  let currentColorMode: ColorMode = 'original';
  let currentLayout: LayoutMode = 'vertical';
  let currentHorizontalRows: HorizontalRowCount = 1;

  // Parámetros de Zoom (1% por paso para ajuste fino sin saltos de 5 en 5)
  const MIN_ZOOM = 0.5; // 50%
  const MAX_ZOOM = 3.0; // 300%
  const ZOOM_STEP = 0.01; // 1%

  // Elementos Globales
  const btnDownload = document.getElementById('btn-download-pdf') as HTMLButtonElement;
  const btnDownloadText = document.getElementById('btn-download-text') as HTMLElement;
  const btnResetAll = document.getElementById('btn-reset-all') as HTMLButtonElement | null;
  const checkboxDuplicateSet = document.getElementById('checkbox-duplicate-set') as HTMLInputElement | null;
  const containerVerticalDuplicate = document.getElementById('container-vertical-duplicate') as HTMLElement | null;
  const containerHorizontalRows = document.getElementById('container-horizontal-rows') as HTMLElement | null;
  const horizRowsButtons = document.querySelectorAll<HTMLButtonElement>('.horiz-rows-btn');
  const horizRowsBadge = document.getElementById('horiz-rows-badge') as HTMLElement | null;
  const sheetSet2Container = document.getElementById('sheet-set2-container') as HTMLElement | null;
  const sheetRow3Container = document.getElementById('sheet-row3-container') as HTMLElement | null;
  const sheetRow4Container = document.getElementById('sheet-row4-container') as HTMLElement | null;
  const colorModeButtons = document.querySelectorAll<HTMLButtonElement>('.color-mode-btn');
  const layoutModeButtons = document.querySelectorAll<HTMLButtonElement>('.layout-mode-btn');

  // Actualiza la disposición visual en la hoja A4 según el layout seleccionado
  function updateLayoutDisplay() {
    const isHoriz = currentLayout === 'horizontal';

    // Tarjeta Frente 1
    const cardFront = elements.front.sheetCard;
    if (cardFront) {
      cardFront.style.left = isHoriz ? '7.619%' : '29.619%';
      cardFront.style.top = isHoriz ? '5.387%' : '6.734%';
    }

    // Tarjeta Dorso 1
    const cardBack = elements.back.sheetCard;
    if (cardBack) {
      cardBack.style.left = isHoriz ? '51.619%' : '29.619%';
      cardBack.style.top = isHoriz ? '5.387%' : '28.956%';
    }

    // Tarjeta Frente 2
    const cardFront2 = elements.front.sheetCard2;
    if (cardFront2) {
      cardFront2.style.left = isHoriz ? '7.619%' : '29.619%';
      cardFront2.style.top = isHoriz ? '29.071%' : '52.869%';
    }

    // Tarjeta Dorso 2
    const cardBack2 = elements.back.sheetCard2;
    if (cardBack2) {
      cardBack2.style.left = isHoriz ? '51.619%' : '29.619%';
      cardBack2.style.top = isHoriz ? '29.071%' : '75.091%';
    }

    // Tarjeta Frente 3 y Dorso 3 (Fila 3 en horizontal)
    const cardFront3 = elements.front.sheetCard3;
    if (cardFront3) {
      cardFront3.style.left = '7.619%';
      cardFront3.style.top = '52.754%';
    }
    const cardBack3 = elements.back.sheetCard3;
    if (cardBack3) {
      cardBack3.style.left = '51.619%';
      cardBack3.style.top = '52.754%';
    }

    // Tarjeta Frente 4 y Dorso 4 (Fila 4 en horizontal)
    const cardFront4 = elements.front.sheetCard4;
    if (cardFront4) {
      cardFront4.style.left = '7.619%';
      cardFront4.style.top = '76.438%';
    }
    const cardBack4 = elements.back.sheetCard4;
    if (cardBack4) {
      cardBack4.style.left = '51.619%';
      cardBack4.style.top = '76.438%';
    }

    // Visibilidad de filas / juegos en la hoja A4
    if (isHoriz) {
      // En horizontal: 1, 2, 3 o 4 filas
      if (sheetSet2Container) {
        if (currentHorizontalRows >= 2) {
          sheetSet2Container.classList.remove('hidden');
        } else {
          sheetSet2Container.classList.add('hidden');
        }
      }
      if (sheetRow3Container) {
        if (currentHorizontalRows >= 3) {
          sheetRow3Container.classList.remove('hidden');
        } else {
          sheetRow3Container.classList.add('hidden');
        }
      }
      if (sheetRow4Container) {
        if (currentHorizontalRows >= 4) {
          sheetRow4Container.classList.remove('hidden');
        } else {
          sheetRow4Container.classList.add('hidden');
        }
      }
    } else {
      // En vertical: duplicado si checkbox está marcado
      const isDuplicate = checkboxDuplicateSet?.checked ?? false;
      if (sheetSet2Container) {
        if (isDuplicate) {
          sheetSet2Container.classList.remove('hidden');
        } else {
          sheetSet2Container.classList.add('hidden');
        }
      }
      if (sheetRow3Container) {
        sheetRow3Container.classList.add('hidden');
      }
      if (sheetRow4Container) {
        sheetRow4Container.classList.add('hidden');
      }
    }
  }

  // Actualiza la interfaz del selector de filas en horizontal
  function updateHorizRowsUI(rows: HorizontalRowCount) {
    currentHorizontalRows = rows;
    horizRowsButtons.forEach(btn => {
      const btnRows = Number(btn.getAttribute('data-rows')) as HorizontalRowCount;
      if (btnRows === rows) {
        btn.classList.remove('bg-slate-800/80', 'text-slate-300', 'border', 'border-slate-700/50');
        btn.classList.add('bg-sky-500', 'text-white', 'font-bold', 'shadow-xs');
      } else {
        btn.classList.remove('bg-sky-500', 'text-white', 'font-bold', 'shadow-xs');
        btn.classList.add('bg-slate-800/80', 'text-slate-300', 'border', 'border-slate-700/50');
      }
    });

    if (horizRowsBadge) {
      const labels: Record<HorizontalRowCount, string> = {
        1: '1 juego (2 fotos)',
        2: '2 juegos (4 fotos)',
        3: '3 juegos (6 fotos)',
        4: '4 juegos (8 fotos)',
      };
      horizRowsBadge.textContent = labels[rows];
    }

    updateLayoutDisplay();
    updateDownloadButtonState();
  }

  // Actualiza el renderizado Canvas
  async function updateCardRender(side: CardSide) {
    const card = cards[side];
    const el = elements[side];

    const copies = [
      { canvas: el.canvasPreview2, placeholder: el.placeholderPreview2, card: el.sheetCard2 },
      { canvas: el.canvasPreview3, placeholder: el.placeholderPreview3, card: el.sheetCard3 },
      { canvas: el.canvasPreview4, placeholder: el.placeholderPreview4, card: el.sheetCard4 },
    ];

    if (!card.imageElement) {
      el.canvasPreview.classList.add('hidden');
      el.placeholderPreview.classList.remove('hidden');
      el.sheetCard.classList.remove('border-none');
      el.sheetCard.classList.add('border-dashed', 'border-slate-300');

      // Limpiar también copias adicionales
      for (const copy of copies) {
        if (copy.canvas && copy.placeholder && copy.card) {
          copy.canvas.classList.add('hidden');
          copy.placeholder.classList.remove('hidden');
          copy.card.classList.remove('border-none');
          copy.card.classList.add('border-dashed', 'border-slate-300');
        }
      }
      return;
    }

    try {
      // Sin marcos ni líneas grises añadidas
      const canvas = await renderCardToCanvas(card, currentColorMode);

      el.canvasPreview.width = canvas.width;
      el.canvasPreview.height = canvas.height;
      const ctx = el.canvasPreview.getContext('2d');
      if (ctx) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(canvas, 0, 0);
      }

      el.miniCanvas.width = canvas.width;
      el.miniCanvas.height = canvas.height;
      const miniCtx = el.miniCanvas.getContext('2d');
      if (miniCtx) {
        miniCtx.clearRect(0, 0, canvas.width, canvas.height);
        miniCtx.drawImage(canvas, 0, 0);
      }

      el.canvasPreview.classList.remove('hidden');
      el.placeholderPreview.classList.add('hidden');
      el.sheetCard.classList.remove('border-dashed', 'border-slate-300');
      el.sheetCard.classList.add('border-none');

      // Actualizar también las copias 2, 3 y 4 en la hoja A4
      for (const copy of copies) {
        if (copy.canvas && copy.placeholder && copy.card) {
          copy.canvas.width = canvas.width;
          copy.canvas.height = canvas.height;
          const copyCtx = copy.canvas.getContext('2d');
          if (copyCtx) {
            copyCtx.clearRect(0, 0, canvas.width, canvas.height);
            copyCtx.drawImage(canvas, 0, 0);
          }
          copy.canvas.classList.remove('hidden');
          copy.placeholder.classList.add('hidden');
          copy.card.classList.remove('border-dashed', 'border-slate-300');
          copy.card.classList.add('border-none');
        }
      }
    } catch (err) {
      console.error(`Error al procesar ${side}:`, err);
    }
  }

  // Actualiza estado del botón de descarga y del botón de reinicio
  function updateDownloadButtonState() {
    const hasAnyImage = cards.front.imageElement !== null || cards.back.imageElement !== null;
    const hasBothImages = cards.front.imageElement !== null && cards.back.imageElement !== null;

    btnDownload.disabled = !hasAnyImage;
    if (btnResetAll) {
      btnResetAll.disabled = !hasAnyImage;
    }

    if (currentLayout === 'horizontal') {
      const rowCount = currentHorizontalRows;
      const totalCards = rowCount * (hasBothImages ? 2 : 1);
      if (hasBothImages) {
        btnDownloadText.textContent = `Descargar Fotocopia PDF (${rowCount} ${rowCount === 1 ? 'Fila' : 'Filas'} • ${totalCards} Tarjetas)`;
      } else if (cards.front.imageElement !== null) {
        btnDownloadText.textContent = `Descargar Fotocopia PDF (${rowCount} ${rowCount === 1 ? 'Copia' : 'Copias'} Frente)`;
      } else if (cards.back.imageElement !== null) {
        btnDownloadText.textContent = `Descargar Fotocopia PDF (${rowCount} ${rowCount === 1 ? 'Copia' : 'Copias'} Dorso)`;
      } else {
        btnDownloadText.textContent = `Descargar Fotocopia PDF (${rowCount} ${rowCount === 1 ? 'Fila' : 'Filas'} • A4 100%)`;
      }
    } else {
      const isDuplicate = checkboxDuplicateSet?.checked ?? false;
      if (isDuplicate) {
        if (hasBothImages) {
          btnDownloadText.textContent = 'Descargar Fotocopia PDF (2 Juegos • 4 Tarjetas)';
        } else if (cards.front.imageElement !== null) {
          btnDownloadText.textContent = 'Descargar Fotocopia PDF (2 Copias del Frente)';
        } else if (cards.back.imageElement !== null) {
          btnDownloadText.textContent = 'Descargar Fotocopia PDF (2 Copias del Dorso)';
        } else {
          btnDownloadText.textContent = 'Descargar Fotocopia PDF (A4 - 100%)';
        }
      } else {
        if (hasBothImages) {
          btnDownloadText.textContent = 'Descargar Fotocopia PDF (Frente y Dorso)';
        } else if (cards.front.imageElement !== null) {
          btnDownloadText.textContent = 'Descargar Fotocopia PDF (Solo Frente)';
        } else if (cards.back.imageElement !== null) {
          btnDownloadText.textContent = 'Descargar Fotocopia PDF (Solo Dorso)';
        } else {
          btnDownloadText.textContent = 'Descargar Fotocopia PDF (A4 - 100%)';
        }
      }
    }
  }

  // Actualiza visualización y estado de los botones de zoom
  function updateZoomDisplay(side: CardSide) {
    const card = cards[side];
    const el = elements[side];

    if (el.zoomVal) {
      el.zoomVal.textContent = `${Math.round(card.zoom * 100)}%`;
    }
    if (el.btnZoomOut) {
      el.btnZoomOut.disabled = card.zoom <= MIN_ZOOM + 0.0001;
    }
    if (el.btnZoomIn) {
      el.btnZoomIn.disabled = card.zoom >= MAX_ZOOM - 0.0001;
    }
  }

  // Ajusta el zoom en pasos de 1% (ZOOM_STEP = 0.01) sin saltos grandes
  function adjustZoom(side: CardSide, delta: number) {
    const card = cards[side];
    if (!card.imageElement) return;

    const newZoom = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, Math.round((card.zoom + delta) * 100) / 100));
    if (Math.abs(newZoom - card.zoom) < 0.0001) return;

    card.zoom = newZoom;
    clampCardOffsets(card);
    updateZoomDisplay(side);
    updateCardRender(side);
  }

  // Configura los botones - y + con soporte para clic rápido y pulsación continua
  function setupZoomControls(side: CardSide) {
    const el = elements[side];
    const card = cards[side];

    const attachHoldListener = (btn: HTMLButtonElement, delta: number) => {
      let timeoutId: number | null = null;
      let intervalId: number | null = null;

      const clearTimers = () => {
        if (timeoutId !== null) {
          clearTimeout(timeoutId);
          timeoutId = null;
        }
        if (intervalId !== null) {
          clearInterval(intervalId);
          intervalId = null;
        }
      };

      btn.addEventListener('pointerdown', (e: PointerEvent) => {
        if (btn.disabled) return;
        e.preventDefault();
        e.stopPropagation();
        clearTimers();
        adjustZoom(side, delta);

        timeoutId = window.setTimeout(() => {
          intervalId = window.setInterval(() => {
            if (btn.disabled) {
              clearTimers();
              return;
            }
            adjustZoom(side, delta);
          }, 40);
        }, 300);
      });

      btn.addEventListener('pointerup', clearTimers);
      btn.addEventListener('pointerleave', clearTimers);
      btn.addEventListener('pointercancel', clearTimers);

      btn.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          adjustZoom(side, delta);
        }
      });
    };

    attachHoldListener(el.btnZoomOut, -ZOOM_STEP);
    attachHoldListener(el.btnZoomIn, ZOOM_STEP);

    // Doble clic en el indicador para restablecer rápidamente al 100%
    el.zoomVal.addEventListener('dblclick', (e) => {
      e.stopPropagation();
      if (!card.imageElement) return;
      card.zoom = 1.0;
      updateZoomDisplay(side);
      updateCardRender(side);
    });
  }

  // Actualiza el estado visual de la tarjeta (Vacío o Listo)
  function setCardUiState(side: CardSide, state: 'empty' | 'ready') {
    const el = elements[side];
    const config = SIDE_CONFIG[side];

    if (state === 'ready') {
      updateZoomDisplay(side);
      el.emptyState.classList.add('hidden');
      el.previewContainer.classList.remove('hidden');
      el.controls.classList.remove('hidden');
      el.badge.textContent = 'Listo';
      el.badge.className = `text-[10px] font-medium px-2 py-0.5 rounded-full border ${config.badgeActiveClass}`;
    } else {
      el.fileInput.value = '';
      updateZoomDisplay(side);
      el.emptyState.classList.remove('hidden');
      el.previewContainer.classList.add('hidden');
      el.controls.classList.add('hidden');
      el.badge.textContent = 'Vacío';
      el.badge.className = 'text-[10px] font-medium px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700';
    }
  }

  // Manejador de selección de imagen
  async function handleFileSelect(file: File, side: CardSide) {
    const el = elements[side];

    // Validación preventiva de tipo de archivo (MIME/extensión) y tamaño
    const validation = validateImageFile(file);
    if (!validation.valid) {
      alert(validation.error);
      el.fileInput.value = '';
      return;
    }

    try {
      const img = await loadFileAsImage(file);
      const card = cards[side];
      card.file = file;
      card.imageElement = img;
      card.rotation = 0;
      card.zoom = 1.0;
      card.offsetX = 0;
      card.offsetY = 0;

      setCardUiState(side, 'ready');
      await updateCardRender(side);
      updateDownloadButtonState();
    } catch (err) {
      alert((err as Error).message || 'Error al cargar la imagen');
      el.fileInput.value = '';
    }
  }

  // Quitar imagen
  function handleRemoveFile(side: CardSide) {
    const card = cards[side];
    card.file = null;
    card.imageElement = null;
    card.rotation = 0;
    card.zoom = 1.0;
    card.offsetX = 0;
    card.offsetY = 0;

    setCardUiState(side, 'empty');
    updateCardRender(side);
    updateDownloadButtonState();
  }

  // Configuración de Drag to Pan interactivo en canvas (Mouse y Touch con PointerEvents)
  function setupPanInteractions(canvas: HTMLCanvasElement, side: CardSide) {
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    canvas.style.touchAction = 'none';

    canvas.addEventListener('pointerdown', (e: PointerEvent) => {
      const card = cards[side];
      if (!card.imageElement) return;
      e.stopPropagation();
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      try {
        canvas.setPointerCapture(e.pointerId);
      } catch (_) {}
      canvas.style.cursor = 'grabbing';
    });

    canvas.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDragging) return;
      e.stopPropagation();
      const card = cards[side];
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      startX = e.clientX;
      startY = e.clientY;

      // Escalar movimiento según resolución nativa del canvas (1011px vs ancho display)
      const scaleFactor = CARD_CONFIG.CANVAS_WIDTH_PX / (canvas.clientWidth || 200);
      card.offsetX += dx * scaleFactor;
      card.offsetY += dy * scaleFactor;
      clampCardOffsets(card);
      updateCardRender(side);
    });

    const stopDragging = (e: PointerEvent) => {
      if (isDragging) {
        isDragging = false;
        try {
          canvas.releasePointerCapture(e.pointerId);
        } catch (_) {}
        canvas.style.cursor = 'grab';
      }
    };

    canvas.addEventListener('pointerup', stopDragging);
    canvas.addEventListener('pointercancel', stopDragging);
  }

  // Vinculación de eventos por cara
  function setupSideListeners(side: CardSide) {
    const el = elements[side];
    const card = cards[side];
    const config = SIDE_CONFIG[side];

    // Activar arrastre en mini-canvas y en la hoja A4
    setupPanInteractions(el.miniCanvas, side);
    setupPanInteractions(el.canvasPreview, side);

    // Activar controles de zoom (- y +)
    setupZoomControls(side);

    // Click en dropzone para abrir selector de archivo
    el.dropzone.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest(`#controls-${side}`) || (e.target as HTMLElement).closest(`#preview-container-${side}`)) return;
      el.fileInput.click();
    });

    // Selección de archivo
    el.fileInput.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files[0]) handleFileSelect(files[0], side);
    });

    // Arrastrar archivo sobre el dropzone
    ['dragenter', 'dragover'].forEach(eventName => {
      el.dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        el.dropzone.classList.add(...config.dragActiveClasses);
      });
    });

    ['dragleave', 'drop'].forEach(eventName => {
      el.dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        el.dropzone.classList.remove(...config.dragActiveClasses);
      });
    });

    el.dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files[0]) handleFileSelect(dt.files[0], side);
    });

    // Botones de acción rápida
    el.btnRotate.addEventListener('click', (e) => {
      e.stopPropagation();
      card.rotation = (card.rotation + 90) % 360;
      clampCardOffsets(card);
      updateCardRender(side);
    });

    el.btnReset.addEventListener('click', (e) => {
      e.stopPropagation();
      card.zoom = 1.0;
      card.offsetX = 0;
      card.offsetY = 0;
      updateZoomDisplay(side);
      updateCardRender(side);
    });

    el.btnRemove.addEventListener('click', (e) => {
      e.stopPropagation();
      handleRemoveFile(side);
    });
  }

  // Inicializar ambas caras
  (['front', 'back'] as const).forEach(setupSideListeners);

  // Modos de Color
  colorModeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      colorModeButtons.forEach(b => {
        b.classList.remove('bg-sky-500/15', 'border-sky-500', 'text-white');
        b.classList.add('border-slate-800', 'text-slate-300');
      });

      btn.classList.remove('border-slate-800', 'text-slate-300');
      btn.classList.add('bg-sky-500/15', 'border-sky-500', 'text-white');

      currentColorMode = (btn.getAttribute('data-mode') || 'original') as ColorMode;
      updateCardRender('front');
      updateCardRender('back');
    });
  });

  // Descarga del PDF
  btnDownload.addEventListener('click', async () => {
    if (!cards.front.imageElement && !cards.back.imageElement) return;

    try {
      const originalText = btnDownloadText.textContent;
      btnDownload.disabled = true;
      btnDownloadText.textContent = 'Generando PDF milimétrico a 300 DPI...';

      await generateAndDownloadPdf({
        frontCard: cards.front,
        backCard: cards.back,
        colorMode: currentColorMode,
        duplicateCopies: checkboxDuplicateSet?.checked ?? false,
        layoutMode: currentLayout,
        horizontalRows: currentHorizontalRows,
      });

      btnDownloadText.textContent = originalText;
      btnDownload.disabled = false;
    } catch (err) {
      console.error('Error al generar PDF:', err);
      alert('Ocurrió un error al generar el PDF. Por favor reintenta.');
      btnDownload.disabled = false;
      updateDownloadButtonState();
    }
  });

  // Selector de Disposición en la Hoja (Vertical u Horizontal)
  layoutModeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      layoutModeButtons.forEach(b => {
        b.classList.remove('bg-sky-500/15', 'border-sky-500', 'text-white');
        b.classList.add('border-slate-800', 'text-slate-300');
      });

      btn.classList.remove('border-slate-800', 'text-slate-300');
      btn.classList.add('bg-sky-500/15', 'border-sky-500', 'text-white');

      currentLayout = (btn.getAttribute('data-layout') || 'vertical') as LayoutMode;

      if (currentLayout === 'horizontal') {
        containerVerticalDuplicate?.classList.add('hidden');
        containerHorizontalRows?.classList.remove('hidden');
      } else {
        containerVerticalDuplicate?.classList.remove('hidden');
        containerHorizontalRows?.classList.add('hidden');
      }

      updateLayoutDisplay();
      updateDownloadButtonState();
    });
  });

  // Selector de Filas en Horizontal (1, 2, 3 o 4 filas)
  horizRowsButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const rows = Number(btn.getAttribute('data-rows')) as HorizontalRowCount;
      if (rows >= 1 && rows <= 4) {
        updateHorizRowsUI(rows);
      }
    });
  });

  // Escuchar cambio en la opción de duplicar juego en vertical
  if (checkboxDuplicateSet) {
    checkboxDuplicateSet.addEventListener('change', () => {
      const isDuplicate = checkboxDuplicateSet.checked;
      if (sheetSet2Container) {
        if (isDuplicate) {
          sheetSet2Container.classList.remove('hidden');
        } else {
          sheetSet2Container.classList.add('hidden');
        }
      }
      updateDownloadButtonState();
    });
  }

  // Reiniciar todo para generar otro PDF
  function resetAllCards() {
    handleRemoveFile('front');
    handleRemoveFile('back');

    if (checkboxDuplicateSet) {
      checkboxDuplicateSet.checked = false;
      if (sheetSet2Container) {
        sheetSet2Container.classList.add('hidden');
      }
    }

    // Restaurar filas en horizontal a 1
    updateHorizRowsUI(1);

    // Restaurar disposición a vertical por defecto
    currentLayout = 'vertical';
    containerVerticalDuplicate?.classList.remove('hidden');
    containerHorizontalRows?.classList.add('hidden');

    layoutModeButtons.forEach(b => {
      const isVertical = b.getAttribute('data-layout') === 'vertical';
      if (isVertical) {
        b.classList.remove('border-slate-800', 'text-slate-300');
        b.classList.add('bg-sky-500/15', 'border-sky-500', 'text-white');
      } else {
        b.classList.remove('bg-sky-500/15', 'border-sky-500', 'text-white');
        b.classList.add('border-slate-800', 'text-slate-300');
      }
    });
    updateLayoutDisplay();

    // Restaurar modo de color a 'original'
    currentColorMode = 'original';
    colorModeButtons.forEach(b => {
      const isOriginal = b.getAttribute('data-mode') === 'original';
      if (isOriginal) {
        b.classList.remove('border-slate-800', 'text-slate-300');
        b.classList.add('bg-sky-500/15', 'border-sky-500', 'text-white');
      } else {
        b.classList.remove('bg-sky-500/15', 'border-sky-500', 'text-white');
        b.classList.add('border-slate-800', 'text-slate-300');
      }
    });

    // Desplazar suavemente hacia arriba para comenzar de nuevo
    elements.front.dropzone.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  if (btnResetAll) {
    btnResetAll.addEventListener('click', resetAllCards);
  }
</script>
